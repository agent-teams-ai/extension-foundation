{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "status", "owner", "summary"],
  "properties": {
    "id": {"type": "string"},
    "type": {"enum": ["index", "open-decision"]},
    "status": {"enum": ["active", "open"]},
    "owner": {"type": "string"},
    "summary": {"type": "string"},
    "related": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "blocked_by": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "code_anchors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enforcement", "pattern"],
        "properties": {
          "enforcement": {"enum": ["advisory", "required"]},
          "pattern": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
