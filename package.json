{
  "name": "@agent-teams/extension-foundation-repository",
  "version": "0.0.0",
  "private": true,
  "description": "Product-neutral extension contracts, OCI distribution, lifecycle primitives, and conformance tooling for Agent Teams products.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-teams-ai/extension-foundation.git"
  },
  "scripts": {
    "architecture:check": "pnpm architecture:topology:check && pnpm architecture:source-dependencies:check && node --test --test-concurrency=1 tests/architecture-topology.test.mjs tests/scaffolding.test.mjs",
    "architecture:check:fast": "pnpm architecture:topology:check && pnpm architecture:source-dependencies:check && node --test --test-concurrency=1 tests/architecture-topology.test.mjs",
    "architecture:scaffold:apply": "node architecture/checks/scaffold.mjs apply",
    "architecture:scaffold:plan": "node architecture/checks/scaffold.mjs plan",
    "architecture:scaffold:recover": "node architecture/checks/scaffold.mjs recover",
    "architecture:source-dependencies:check": "agent-teams-foundation check architecture.source-dependencies",
    "architecture:topology:check": "node architecture/checks/package-topology.mjs",
    "check": "pnpm foundation:check && pnpm docs:protocol:check && pnpm architecture:check && pnpm typecheck && pnpm packages:check",
    "check:changed": "agent-teams-foundation agent-workflow changed --consumer .",
    "check:fast": "pnpm foundation:check && pnpm docs:protocol:check && pnpm architecture:check:fast && pnpm typecheck",
    "docs:changed": "pnpm docs:check && pnpm docs:quality",
    "docs:check": "agent-teams-docs check --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:contract-test": "node --test tests/document-authoring.test.mjs tests/docs-protocol-qualification.test.mjs",
    "docs:doctor": "agent-teams-docs doctor --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:find": "agent-teams-docs find --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:info": "agent-teams-docs info --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:new": "agent-teams-docs new --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:protocol:check": "pnpm docs:check && pnpm docs:quality && pnpm docs:contract-test",
    "docs:quality": "markdownlint-cli2 && cspell --config .cspell.json --no-progress",
    "docs:recover": "agent-teams-docs recover --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "foundation:assert-dev-only": "agent-teams-foundation assert-dev-only",
    "foundation:assert-registry": "agent-teams-foundation assert-registry",
    "foundation:attach": "agent-teams-foundation attach",
    "foundation:check": "agent-teams-foundation check && pnpm foundation:assert-dev-only && pnpm foundation:assert-registry",
    "foundation:detach": "agent-teams-foundation detach",
    "foundation:status": "agent-teams-foundation status",
    "packages:check": "pnpm --recursive --filter './packages/**' check",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@agent-teams/docs-protocol": "0.1.1",
    "@agent-teams/engineering-foundation": "0.17.0",
    "cspell": "catalog:",
    "markdownlint-cli2": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
