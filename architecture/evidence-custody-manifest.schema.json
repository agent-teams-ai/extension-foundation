{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.ai/schemas/evidence-custody-manifest.v2.json",
  "title": "Evidence custody manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "campaignId",
    "baseline",
    "objects",
    "jobs",
    "attempts",
    "continuations",
    "claims",
    "exceptions",
    "promotion"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "campaignId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivation",
        "repository",
        "commit",
        "tree",
        "lockfileSha256",
        "clean",
        "platform",
        "nodeVersion",
        "pnpmVersion",
        "capturedAt"
      ],
      "properties": {
        "derivation": { "const": "canonical-repository-observation-v1" },
        "repository": { "type": "string", "maxLength": 256, "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9._-]*$" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "lockfileSha256": { "$ref": "#/$defs/digest" },
        "clean": { "const": true },
        "platform": { "$ref": "#/$defs/shortString" },
        "nodeVersion": { "$ref": "#/$defs/shortString" },
        "pnpmVersion": { "$ref": "#/$defs/shortString" },
        "capturedAt": { "$ref": "#/$defs/shortString" }
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/object" }
    },
    "jobs": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/job" }
    },
    "attempts": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/attempt" }
    },
    "continuations": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/continuation" }
    },
    "claims": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/claim" }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/exception" }
    },
    "promotion": { "$ref": "#/$defs/promotion" }
  },
  "$defs": {
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "shortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "mediaType", "kind", "sourcePath", "capturedAt"],
      "properties": {
        "sha256": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "mediaType": { "$ref": "#/$defs/shortString" },
        "kind": { "$ref": "#/$defs/shortString" },
        "sourcePath": { "type": "string", "maxLength": 65536, "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\\\\)(?!.*\\u0000)(?!\\.\\.?(?:/|#|$))[^/#]+(?:/(?!\\.\\.?(?:/|#|$))[^/#]+)*(?:#(?!\\.\\.?(?:/|$))[^/#]+(?:/(?!\\.\\.?(?:/|$))[^/#]+)*)?$" },
        "capturedAt": { "$ref": "#/$defs/shortString" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "wave", "jobConfigObject", "attemptIds", "currentAlias", "capturedObjects"],
      "properties": {
        "jobId": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^modres-w(?:[1-9]|10|11)-[a-z0-9][a-z0-9-]*-[0-9]{8}-r[0-9]+$"
        },
        "wave": { "type": "string", "maxLength": 3, "pattern": "^W(?:[1-9]|10|11)$" },
        "jobConfigObject": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "attemptIds": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/shortString" },
          "uniqueItems": true
        },
        "currentAlias": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "capturedObjects": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/digest" },
          "uniqueItems": true
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptId",
        "jobId",
        "attemptNumber",
        "status",
        "predecessorAttemptId",
        "continuationOf",
        "startedAt",
        "finishedAt",
        "outputSummaryObject",
        "wrapperObject",
        "transcriptObjects"
      ],
      "properties": {
        "attemptId": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^modres-w(?:[1-9]|10|11)-[a-z0-9][a-z0-9-]*-[0-9]{8}-r[0-9]+:attempt:[1-9][0-9]*$"
        },
        "jobId": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^modres-w(?:[1-9]|10|11)-[a-z0-9][a-z0-9-]*-[0-9]{8}-r[0-9]+$"
        },
        "attemptNumber": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "status": {
          "enum": ["abandoned", "blocked", "cancelled", "completed", "done", "failed"]
        },
        "predecessorAttemptId": { "type": ["string", "null"], "maxLength": 256 },
        "continuationOf": { "type": ["string", "null"], "maxLength": 256 },
        "startedAt": { "$ref": "#/$defs/shortString" },
        "finishedAt": { "$ref": "#/$defs/shortString" },
        "outputSummaryObject": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "wrapperObject": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "transcriptObjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/digest" },
          "uniqueItems": true
        }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptId", "continuationOf"],
      "properties": {
        "attemptId": { "$ref": "#/$defs/shortString" },
        "continuationOf": { "$ref": "#/$defs/shortString" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "text",
        "classification",
        "applicability",
        "primarySourceObjects",
        "executableEvidenceObjects",
        "publisherIndependence",
        "executableEvidenceAttestations",
        "hypothesis",
        "promotionEligible"
      ],
      "properties": {
        "claimId": { "$ref": "#/$defs/shortString" },
        "text": { "$ref": "#/$defs/boundedString" },
        "classification": {
          "enum": ["observed", "inference", "hypothesis", "decision-authority", "unsupported", "contradicted"]
        },
        "applicability": { "$ref": "#/$defs/boundedString" },
        "primarySourceObjects": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/digest" },
          "uniqueItems": true
        },
        "executableEvidenceObjects": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/digest" },
          "uniqueItems": true
        },
        "publisherIndependence": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceObject", "publisher"],
            "properties": {
              "sourceObject": { "$ref": "#/$defs/digest" },
              "publisher": { "$ref": "#/$defs/shortString" }
            }
          }
        },
        "executableEvidenceAttestations": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidenceObject", "attestationObject", "publisher", "status"],
            "properties": {
              "evidenceObject": { "$ref": "#/$defs/digest" },
              "attestationObject": { "$ref": "#/$defs/digest" },
              "publisher": { "$ref": "#/$defs/shortString" },
              "status": { "const": "passed" }
            }
          }
        },
        "hypothesis": { "type": "boolean" },
        "promotionEligible": { "type": "boolean" }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exceptionId", "kind", "detail"],
      "properties": {
        "exceptionId": { "$ref": "#/$defs/shortString" },
        "kind": { "$ref": "#/$defs/shortString" },
        "detail": { "$ref": "#/$defs/boundedString" }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftScope",
        "synthesisVerdict",
        "workerAccounting",
        "manifestGates",
        "productOwnerReview",
        "separateAdrChange",
        "p0P1ExecutableClosure"
      ],
      "properties": {
        "draftScope": { "const": "evidence-tooling-only" },
        "synthesisVerdict": { "const": "NO-GO" },
        "workerAccounting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["countsAsVotes"],
          "properties": {
            "countsAsVotes": { "const": false }
          }
        },
        "manifestGates": { "const": false },
        "productOwnerReview": { "const": false },
        "separateAdrChange": { "const": false },
        "p0P1ExecutableClosure": { "const": false }
      }
    }
  }
}
